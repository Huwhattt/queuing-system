      <AuxValues>
        <AuxValue name="JavaCodeGenerator_InitCodePre" type="java.lang.String" value="pfield.addKeyListener(new KeyAdapter() {&#xa;            public void keyTyped(KeyEvent e) {&#xa;                char c = e.getKeyChar();&#xa;                if (!Character.isDigit(c) || pfield.getPassword().length &gt;= 6) {&#xa;                    e.consume();&#xa;                }&#xa;            }&#xa;        });&#xa;pfield.setBorder(null);              &#xa;pfield.setOpaque(false);            &#xa;pfield.setBackground(new java.awt.Color(0,0,0,0));"/>
